{
    "version": 2,
    "builds": [
        {
            "src": "login.py",
            "use": "@vercel/python"
        },
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        },
        {
            "src": "templates/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "login.py"
        },
        {
            "src": "/dashboard",
            "dest": "app.py"
        },
        {
            "src": "/static/(.*)",
            "dest": "static/$1"
        },
        {
            "src": "/templates/(.*)",
            "dest": "templates/$1"
        }
    ]
}