{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "healthcare.py",
            "use": "@vercel/python"
        },
        {
            "src": "reminder.py",
            "use": "@vercel/python"
        },
        {
            "src": "graph.py",
            "use": "@vercel/python"
        },
        {
            "src": "login.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        },
        {
            "src": "templates/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "app.py"
        },
        {
            "src": "/healthcare",
            "dest": "healthcare.py"
        },
        {
            "src": "/reminder",
            "dest": "reminder.py"
        },
        {
            "src": "/graph",
            "dest": "graph.py"
        },
        {
            "src": "/login/(.*)",
            "dest": "login.py"
        },
        {
            "src": "/static/(.*)",
            "dest": "static/$1"
        },
        {
            "src": "/templates/(.*)",
            "dest": "templates/$1"
        }
    ],
    "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "production",
        "PYTHONPATH": ".",
        "PYTHONUNBUFFERED": "1"
    }
} 